# ── Client MongoDB (read-only) ─────────────────────────────────────────────────
# Provided by the client. The app never writes to this database.
MONGODB_URI=mongodb://mongo:27017

# ── Our internal PostgreSQL (read/write) ──────────────────────────────────────
# Stores schema registry, golden records, and chat history.
POSTGRES_URI=postgresql://bi:secret@postgres:5432/bi_wikolabs
POSTGRES_PASSWORD=secret

# ── LLM ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Chainlit ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CHAINLIT_AUTH_SECRET=your_chainlit_auth_secret_here
